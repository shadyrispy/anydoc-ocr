/target
**/*.rs.bk
# 第三方预编译库按架构分目录；预编译二进制不入库（本地下载即可）
third_party/*/linux-x64
third_party/*/linux-aarch64
third_party/*/x64
third_party/*/aarch64
third_party/*.tgz
third_party/dl/
# 构建/打包产物
/dist
# CJK 字体由 scripts/install-font.sh 安装，不入库
/fonts
# 真实公文样本体积大，不入库；tests/samples 生成样本保留
/tests/real_samples
# MinerU 回归对照产物（36MB 输出/中间件），本地存档不入库
/compare/
# 根目录回归 scratch：真实样本 PDF 与其转换/对照 md（基线一律进 tests/golden）
/*_sample.pdf
/*_orig.md
/*_out.md
/*_small.md
# agent 会话产物（设计稿导出）
/.claude/
# 运行/调试日志
*.log
# 一次性实验脚本（INT8 量化探针、压测、加固笔记）；本地存档，不入库
/.scratch
# ADR/架构文档本地维护，不入库
/docs
# 临时分享包/产物
/.trae-html-share-packages
/*.html
# 临时评估对比脚本
/scripts/compare_accuracy*.py
# MinerU 真 CLI 对照跑在仓根时落的 blob 缓存（mineru parse 副产物）
/blobs
third_party/oar-ocr-core/.cargo-ok
third_party/oar-ocr-core/Cargo.lock
**/target
